	"rule.v_lim5":     ["VIOLATION · SHOT LIMIT (ROLE 5)", "INFRAZIONE · LIMITE TIRI (RUOLO 5)"],
	"rule.v_lim5.body": ["Role 5 may take at most 3 shots per period. Turnover.",
