	"rule.foul":         ["DEFENSIVE FOUL", "FALLO DIFENSIVO"],
	"match.deliver.need_area": ["Pivot only gets the ball from INSIDE the area — carry it in and hand it over.", "Al pivot si consegna la palla solo da DENTRO l'area."],
	"match.deliver.two_man":   ["Move the ball to another team-mate first — no instant give-back to the pivot.", "Prima passa a un altro compagno: non si ripassa subito al pivot."],
	"match.area.reach":        ["That ball is the pivot's: roles 3-5 may not reach inside the area.", "Quella palla e' del pivot: i ruoli 3-5 non entrano nell'area."],
	"match.area.loose":        ["Ball in the area: it belongs to the pivot.", "Palla in area: e' del pivot."],
	"match.area.loose2":       ["Ball stuck in the area with a role-2 pivot: jump ball at centre court.", "Palla ferma in area con un pivot ruolo 2: palla a due a centro campo."],
	"rule.v_area_in":          ["VIOLATION · SMALL SIDE AREA", "INFRAZIONE · AREA LATERALE"],
