	"rule.v_area":     ["VIOLATION · OUTSIDE THE AREA", "INFRAZIONE · FUORI DALL'AREA"],
	"rule.v_area.body": ["Shots at the side baskets must be taken from OUTSIDE the painted area. Turnover.",
